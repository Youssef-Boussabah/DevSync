{
  "name": "@devsync/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared schemas, types, constants, and protocol definitions for DevSync.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"['dist','coverage','.turbo','tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'].forEach((p) => require('fs').rmSync(p, { recursive: true, force: true }))\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@devsync/config": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
