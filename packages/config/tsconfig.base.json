{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@devsync/config — strict base",

  // Correctness and safety only. Deliberately says nothing about `target`, `lib`,
  // `module`, or emit, because those are the settings a framework legitimately owns.
  // Every other config in this package extends this one and adds that layer.
  "compilerOptions": {
    "strict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,

    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
