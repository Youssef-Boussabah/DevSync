{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@devsync/config — library package",
  "extends": "./tsconfig.base.json",

  // Every `packages/*` library: ESM, type-checked in place, never emitted. The
  // packages are consumed through their `exports` map as TypeScript source, so the
  // consuming application's compiler is what produces output.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "noEmit": true
  }
}
