{
  "name": "@devsync/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared development configuration for DevSync workspaces.",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.package.json": "./tsconfig.package.json",
    "./tsconfig.nest.json": "./tsconfig.nest.json",
    "./tsconfig.next.json": "./tsconfig.next.json",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/nest": "./eslint/nest.mjs"
  },
  "files": [
    "eslint",
    "tsconfig.base.json",
    "tsconfig.package.json",
    "tsconfig.nest.json",
    "tsconfig.next.json"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"console.log('@devsync/config: configuration only, nothing to test.')\"",
    "clean": "node -e \"['.turbo','tsconfig.tsbuildinfo'].forEach((p) => require('fs').rmSync(p, { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "typescript-eslint": "^8.65.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "eslint": "^9.39.5"
  }
}
