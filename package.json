{
  "name": "devsync",
  "version": "0.0.0",
  "private": true,
  "description": "DevSync monorepo — browser-based collaborative development environment.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:db": "turbo run test:db --filter=@devsync/database && turbo run test:db --filter=@devsync/api",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:install": "pnpm --filter @devsync/e2e run test:e2e:install",
    "test:all": "pnpm test && pnpm test:db && pnpm test:e2e",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('.turbo',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.8"
  }
}
