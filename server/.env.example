# Origin allowed by CORS and Socket.IO. Defaults to http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# Port the server listens on. Defaults to 5000.
PORT=5000

# JDoodle Compiler API credentials for POST /api/execute. Server-side only — neither may
# ever be given a NEXT_PUBLIC_ name or reach the browser. Leave them empty to run DevSync
# without code execution: collaboration works either way and /api/execute answers 503.
# Both are required; setting only one leaves execution unavailable.
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# JDoodle execute endpoint. Not a secret. The default is the real one; it is overridable
# so the test suite can point the proxy at a fake upstream.
JDOODLE_API_URL=https://api.jdoodle.com/v1/execute
