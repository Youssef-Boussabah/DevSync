# Origin allowed by CORS and Socket.IO. Defaults to http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# Port the server listens on. Defaults to 5000.
PORT=5000

# Judge0 (RapidAPI) key for POST /api/execute. Server-side only — it must never be given
# a NEXT_PUBLIC_ name or reach the browser. Leave it empty to run DevSync without code
# execution: collaboration works either way and /api/execute answers 503.
JUDGE0_API_KEY=

# Judge0 endpoint. These defaults match RapidAPI's Judge0 CE and rarely need changing.
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
