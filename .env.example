# DevSync — the environment variables this repository understands.
#
# Copy this file to `.env` at the repository root and adjust it if you need to.
# `apps/api` loads it on startup and `apps/web` loads it while it builds; `.env`
# is git-ignored, and real secrets never belong in this example.
#
# Values already set in your shell win over the file, which is how Compose and CI
# stay in control of their own configuration.

# apps/api — port the NestJS HTTP server listens on (default: 3001).
API_PORT=3001

# The database `apps/api` and `@devsync/database` use. Required: the API refuses
# to start without it rather than falling back to a default, because a service
# quietly writing to the wrong database is worse than one that does not start.
#
# Port 5433, not 5432: Compose publishes PostgreSQL there so it cannot collide
# with a PostgreSQL a developer already has installed. See `compose.yaml`.
DATABASE_URL=postgresql://devsync:devsync@127.0.0.1:5433/devsync

# The disposable database `pnpm test:db` and `pnpm test:e2e` use. `apps/api`
# never reads it. Its schema is dropped and re-migrated before the database
# tests run, so the tooling refuses any name but `devsync_test`, and refuses it
# outright if it addresses the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql://devsync:devsync@127.0.0.1:5433/devsync_test

# Where the browser reaches the API. Required by `apps/web`, and **embedded into
# the JavaScript `next build` emits** — changing it means rebuilding, which is why
# it is part of the build task's environment hash in `turbo.json`.
#
# `NEXT_PUBLIC_` means public: whatever is here is visible to every visitor.
# Nothing server-only — no database URL, ever — may be given such a name.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# The one origin `apps/api` answers cross-origin browser requests for. Required
# from C3, because that is when the browser first calls the API from a different
# origin. It is matched exactly: `http://localhost:3000` and
# `http://127.0.0.1:3000` are two different origins to a browser, so open DevSync
# at the address named here.
WEB_ORIGIN=http://127.0.0.1:3000

# --- Compose host ports (optional) -------------------------------------------
#
# Read by `compose.yaml` only, never by an application, and left commented out on
# purpose: the values below are the defaults, so copying this file changes
# nothing. Inside the Compose network the ports never move.
#
# They exist because C4's restart validation brings a disposable copy of the same
# stack up in its own Compose project while yours may be running, and it sets all
# three in the environment it passes to Compose. Set them yourself only if
# something on your machine already owns one of these ports — and remember that
# the web build embeds the API address, so changing API_HOST_PORT means
# `docker compose build web` again.
#
# WEB_HOST_PORT=3000
# API_HOST_PORT=3001
# POSTGRES_HOST_PORT=5433
