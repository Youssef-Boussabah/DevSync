# DevSync — the environment variables this repository currently understands.
#
# Phase A0 has no configuration module, so `.env` is NOT loaded automatically.
# This file is the documented inventory of supported variables; set them in your
# shell or process manager to override the defaults:
#
#   API_PORT=4000 pnpm --filter @devsync/api dev
#
# `.env` is git-ignored and reserved for local values once automatic loading is
# introduced. Never put real secrets in this example file.
#
# There is no database, no authentication, and no third-party service in Phase A0,
# so the port below is genuinely the only setting that exists.

# apps/api — port the NestJS HTTP server listens on (default: 3001).
API_PORT=3001
